<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The board is a dark surface in the browser; the shell matches it so the
         app doesn't flash white on every cold start. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">@color/ideabrd_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme">
        <item name="android:windowBackground">@color/ideabrd_background</item>
    </style>
</resources>
